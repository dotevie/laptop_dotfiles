{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.local/share/fastfetch/ascii/fedora.txt",
        "padding": {
            "top": 0,
	    "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "• "
    },
    "modules": [
	"break",
	//"break",
	{
            "type": "title",
            "color": {
                "user": "32",  // = color2
                "at": "37",
                "host": "32"
            }
        },
	"separator",
        //"break",
        {
            "type": "os",
            //"key": "distribution   ",
	    "key": " ",
            "keyColor": "33",
        },
        {
            "type": "kernel",
            //"key": "linux kernel   ",
	    "key":" ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            //"format": "{} (pacman)",
            //"key": "packages       ",
	    "key": " ",
            "keyColor": "33",  
        },
        {
            "type": "shell",
            //"key": "unix shell     ",
	    "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "terminal",
            //"key": "terminal       ",
	    "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "wm",
            "format": "{} ({3})",
            //"key": "window manager ",
	    "key": " ",
            "keyColor": "33", 
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
        },
        "break",
        //"break",
    ]
}

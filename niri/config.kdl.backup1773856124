/*
    evelyn's niri+DMS config

    config.kdl
    ==========
    this is the root config file that niri reads from.
    feel free to write your config in this file, but i've decided to separate everything out.
    everything here is commented with what it does, so i hope it's a good introduction to all this.

    KEEP IN MIND:
    everything in the "components" folder is free to modify as you please.
    everything in the "dms" folder can be overwritten by DMS and should be considered non-persistent.
    
    i recommend consulting the niri config documentation at https://yalter.github.io/niri/
*/

/*
    plays a startup sound.
    looks in /usr/share/sounds/modern-minimal-ui-sounds-v1.1/stereo/desktop-login.oga
    download what i used from https://www.gnome-look.org/p/2225430
*/
include "components/startup-sound.kdl"

/*
    this is where your shell environment variables go.
    anything shell-specific that doesn't live in your rc files should go here.
*/
include "components/environment.kdl"

/*
    this is where i put startup spawns (e.g. DMS).
    if you want something to start at login, put it here.
*/
include "components/spawns.kdl"

include "dms/outputs.kdl"

/*
    this is where rules for screen outputs go (e.g. scale, resolution, refresh rate, etc).
    if you need to configure, add, or change any outputs, this is where to do that.
    if you don't have the same laptop as me, you will need to do this.
*/
include "components/outputs-override.kdl"

/*
    this is where input device configuration lives.
    if you want to mess with something like natural scroll, that goes here.
*/
include "components/input.kdl"

/*
    this is where animations live.
    if you want to change timing, easing, or other animation options, that's here.
*/
include "components/animations.kdl"

/*
    this is where the layout (column widths, defaults, column centering) go.
    these are good defaults, and you shouldn't need to change them, but feel free.
*/
include "components/layout.kdl"

/*
    this is where the Xcursor config is.
    if you install a different cursor and want to change it to that, change "xcursor-theme".
*/
include "components/cursor.kdl"



/*
    these are the niri system keybinds.
    anything declared here can be overridden in DMS, but you can also change them here instead if you like.
*/
include "components/binds.kdl"

/*
    this is where miscellaneous things are.
    if you aren't sure where something should go (or it doesn't fit cleanly into another file), this isn't a bad place.
*/
include "components/miscellaneous.kdl"

/*
    DMS layout configuration.
    configures things like corner radii.
    not recommended to touch.
*/
include "dms/layout.kdl"


/*
    these are all of the window rules.
    they control things like whether something opens floating, changing specific settings for specific windows, and things like that.
    if you want to write your own window rules, i highly recommend consulting the niri documentation.
*/
include "components/rules.kdl"

/*
    DMS color configuration.
    configures border and highlight colors based on your wallpaper.
    not recommended to touch.
*/
include "dms/colors.kdl"

/*
    color configuration overrides.
    if you want something to be a different color than what DMS set, change it here.
*/
include "components/color-overrides.kdl"

/*
    layout configuration overrides.
    if you want to change anything about the layout (e.g. panel gaps, corners), do it here.
*/
include "components/layout-overrides.kdl"

/*
    DMS binds configuration.
    any binds configured or overwritten in the GUI live here.
    despite the warning, should be fine to touch, but i recommend restarting DMS after if you do.
*/
include "dms/binds.kdl"

/*
    DMS alt+tab picker configuration.
    sets corner radii on the alt+tab picker.
    not recommended to touch.
*/
include "dms/alttab.kdl"

/*
    alt+tab picker configuration overrides.
    if you want to mess with the alt+tab picker at all, you should do it here.
*/
include "components/alttab-overrides.kdl"

/*
    DMS wallpaper blur configuration.
    places the blurred wallpaper in the backdrop if you enable it in the GUI.
    you should never need to touch this.
*/
include "dms/wpblur.kdl"

include "dms/windowrules.kdl"
